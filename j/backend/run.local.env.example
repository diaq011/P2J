# ---------------------------------------------------------------------------
# 环境变量模板（非机密）。使用方式：
#   cp run.local.env.example run.local.env
# 然后在 run.local.env 中填入真实的 DEEPSEEK_API_KEY。
#
# 重要：真实的 run.local.env 已被 .gitignore 忽略（匹配 *.local.env），
#      切勿把真实 API Key 提交到仓库。后端启动时由 app.py::_load_local_env()
#      自动读取本目录下的 run.local.env（import LLM 客户端之前）。
# ---------------------------------------------------------------------------

# 必填：DeepSeek API Key（OpenAI 兼容）。请替换为你自己的 key，不要提交真实值。
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 可选：API 地址（默认即 DeepSeek 官方，OpenAI 兼容路径 /chat/completions、/models）。
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 可选：对话 / 计划生成使用的模型。
DEEPSEEK_MODEL=deepseek-chat

# 可选：空闲时段解析使用的模型（可与主模型不同）。
AVAILABILITY_DEEPSEEK_MODEL=deepseek-chat

# 可选：监听端口。macOS 的 AirPlay 常占用 5000，故默认 5001。
APP_PORT=5001

# 可选：其他可调参数（不填则用代码默认值）。
# APP_HOST=0.0.0.0
# DEEPSEEK_TIMEOUT_SEC=90
# P_TYPE_SLOW_MULTIPLIER=1.18
# ESTIMATE_PERCENTILE=p50
# RAG_TOP_K=5
